{
  "name": "qa-regio3",
  "version": "0.1.0",
  "description": "Suite Playwright de automatizacion de QA para el Regionalizador (chips) de farmacity.com - TQD-1128 / FARMA-5049",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:list": "playwright test --list",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint:tests": "node scripts/lint-tests.js",
    "verify": "npm run typecheck && npm run lint:tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GonzaloFarma/qa-regio3.git"
  },
  "keywords": ["playwright", "qa", "regionalizador", "farmacity", "TQD-1128"],
  "author": "",
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "typescript": "^7.0.2"
  }
}
