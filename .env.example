# Ambiente de desarrollo usado por TQD-1128 (NO produccion).
QA_BASE_URL=https://farma5049--farmacityar.myvtex.com
QA_SITE_EDITOR_PATH=/admin/cms/site-editor

# farma5049 es workspace development: exige login + 2FA de VTEX Admin, no
# automatizable. La sesion se captura a mano una vez con `npm run auth:save`
# (scripts/save-workspace-auth.js) y queda en QA_STORAGE_STATE (nunca commitear
# ese archivo, ver .gitignore). No hay variables de credenciales aca porque el
# script no auto-completa nada: el login entero se hace en el browser que abre.
QA_STORAGE_STATE=.auth/farma5049.json

# Datos de prueba reales a completar por quien ejecute (ver Plan_TestCases_Chips.md):
# sucursal(es) con retiro gratuito, sucursal abierto24hs=true/false, SKU vendible, etc.
QA_TEST_SKU=
QA_TEST_LOCATION=
